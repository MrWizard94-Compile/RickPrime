{
  "name": "rickprime",
  "version": "1.0.0",
  "private": true,
  "description": "RickPrime is WPAI's local-first multiverse studio workstation.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1 --port 5178",
    "dev:electron": "wait-on http://127.0.0.1:5178 && electron . --dev-server-url=http://127.0.0.1:5178",
    "desktop": "npm run dev",
    "lint": "tsc --noEmit",
    "test": "node --test test/**/*.test.cjs",
    "build": "npm run lint && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "dist:dir": "npm run package:win",
    "dist:win": "npm run package:win",
    "package:win": "npm run build && electron-packager . RickPrime --platform=win32 --arch=x64 --out=dist-desktop/RickPrime-WPAI-Integrated --overwrite --asar",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('dist-desktop',{recursive:true,force:true});\""
  },
  "dependencies": {
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.4",
    "electron": "43.2.0",
    "@electron/packager": "20.0.4",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "wait-on": "9.1.0"
  }
}
